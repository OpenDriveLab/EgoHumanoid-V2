@@ -0,0 +1,198 @@
+"""OpenPI HTTP adapter for SONIC motion-token inference."""
+
+from __future__ import annotations
+
+import base64
+import json
+from typing import Any, Callable, Optional
+from urllib.request import Request, urlopen
+
+import numpy as np
+
+
+Transport = Callable[[str, str, Optional[dict], float], dict]
+
+
+class OpenPIHttpPolicy:
+    """Expose OpenPI's ``/act`` endpoint through the GR00T client interface."""
+
+    def __init__(
+        self,
+        host: str,
+        port: int,
+        timeout_s: float = 120.0,
+        *,
+        transport: Transport | None = None,
+    ) -> None:
+        if timeout_s <= 0:
+            raise ValueError("timeout_s must be positive")
+        self._base_url = f"http://{host}:{int(port)}"
+        self._timeout_s = float(timeout_s)
+        self._transport = transport or self._request_json
+        self._health: dict[str, Any] | None = None
+        self._health_error: str | None = None
+
+    def _request_json(
+        self,
+        method: str,
+        path: str,
+        payload: dict | None,
+        timeout_s: float,
+    ) -> dict:
+        data = None
+        headers = {"Accept": "application/json"}
+        if payload is not None:
+            data = json.dumps(payload).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        request = Request(
+            f"{self._base_url}{path}", data=data, headers=headers, method=method
+        )
+        with urlopen(request, timeout=timeout_s) as response:  # noqa: S310
+            decoded = json.loads(response.read().decode("utf-8"))
+        if not isinstance(decoded, dict):
+            raise RuntimeError(f"OpenPI {path} returned non-object JSON")
+        return decoded
+
+    @staticmethod
+    def _health_problem(health: dict) -> str | None:
+        problems = []
+        if health.get("status") != "healthy":
+            problems.append(f"status={health.get('status')!r}")
+        if health.get("state_dim") != 43:
+            problems.append(f"state_dim={health.get('state_dim')!r}, expected 43")
+        if health.get("action_dim") != 76:
+            problems.append(f"action_dim={health.get('action_dim')!r}, expected 76")
+        if health.get("requires_state") is not True:
+            problems.append(
+                f"requires_state={health.get('requires_state')!r}, expected True"
+            )
+        return "; ".join(problems) or None
+
+    def _verify_health(self) -> dict:
+        health = self._transport("GET", "/health", None, min(5.0, self._timeout_s))
+        problem = self._health_problem(health)
+        self._health = health
+        self._health_error = problem
+        if problem:
+            raise RuntimeError(f"incompatible OpenPI server: {problem}")
+        return health
+
+    def ping(self) -> bool:
+        try:
+            self._verify_health()
+            return True
+        except Exception as exc:
+            self._health_error = str(exc)
+            return False
+
+    def get_action(self, observation: dict) -> tuple[dict[str, np.ndarray], dict]:
+        import cv2
+
+        if self._health is None or self._health_error is not None:
+            self._verify_health()
+        frame_rgb = np.asarray(observation["video"]["ego_view"][0, 0], dtype=np.uint8)
+        if frame_rgb.ndim != 3 or frame_rgb.shape[-1] != 3:
+            raise ValueError(f"ego_view must be HxWx3 RGB, got {frame_rgb.shape}")
+        frame_bgr = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2BGR)
+        ok, encoded = cv2.imencode(".jpg", frame_bgr)
+        if not ok:
+            raise RuntimeError("failed to JPEG-encode OpenPI observation")
+
+        state = np.asarray(observation["q"], dtype=np.float32).reshape(-1)
+        if state.shape != (43,) or not np.isfinite(state).all():
+            raise ValueError(f"OpenPI SONIC state must be finite (43,), got {state.shape}")
+        prompt = observation["language"]["annotation.human.task_description"][0][0]
+        payload = {
+            "observation": {
+                "ego_view": base64.b64encode(encoded.tobytes()).decode("ascii"),
+                "state": state.tolist(),
+            },
+            "encode_mode": "jpeg_base64",
+            "instruction": str(prompt),
+        }
+        response = self._transport("POST", "/act", payload, self._timeout_s)
+        actions = np.asarray(response.get("actions"), dtype=np.float32)
+        if actions.ndim != 2 or actions.shape[1] != 76:
+            raise ValueError(f"OpenPI SONIC action must be (T, 76), got {actions.shape}")
+        if not np.isfinite(actions).all():
+            raise ValueError("OpenPI SONIC action contains non-finite values")
+        return {
+            "motion_token": actions[:, :64],
+            "left_hand_joints": actions[:, 64:70],
+            "right_hand_joints": actions[:, 70:76],
+        }, {"server_config": self._health.get("config")}
+
+
+POLICY_STATE_DIM = 43
+WIRE_HAND_DIM = 7
+
+def _required_state_vector(state_msg: dict, key: str, size: int) -> np.ndarray:
+    if key not in state_msg:
+        raise ValueError(f"robot state is missing {key}")
+    value = np.asarray(state_msg[key], dtype=np.float32).reshape(-1)
+    if value.size < size:
+        raise ValueError(
+            f"robot state {key} must contain at least {size} values, got {value.size}"
+        )
+    value = value[:size].copy()
+    if not np.isfinite(value).all():
+        raise ValueError(f"robot state {key} contains non-finite values")
+    return value
+
+
+def _policy_hand_state(
+    state_msg: dict, hand_type: str
+) -> tuple[np.ndarray, np.ndarray, str]:
+    if hand_type == "brainco":
+        # The human-data pipeline builds observation.state hands from the 6-D
+        # teleop command, not from BrainCo motor feedback. C++ exposes that same
+        # semantic value as last_*_hand_action; its measured HandState path is
+        # empty for BrainCo and would otherwise make all 14 hand state slots zero.
+        left = _required_state_vector(state_msg, "last_left_hand_action", 6)
+        right = _required_state_vector(state_msg, "last_right_hand_action", 6)
+        left = np.pad(left, (0, WIRE_HAND_DIM - left.size))
+        right = np.pad(right, (0, WIRE_HAND_DIM - right.size))
+        return left, right, "measured_body+commanded_brainco_hands"
+    if hand_type != "dex3":
+        raise ValueError(f"unsupported policy hand_type: {hand_type}")
+
+    left = _required_state_vector(state_msg, "left_hand_q", WIRE_HAND_DIM)
+    right = _required_state_vector(state_msg, "right_hand_q", WIRE_HAND_DIM)
+    # Apply the left Dex3 hardware-coupling projection without
+    # mutating the state message shared by other consumers.
+    left[5] = left[3]
+    left[6] = left[4]
+    return left, right, "measured_body+measured_dex3_hands"
+
+
+def build_policy_qpos(
+    state_msg: dict, robot_model, *, hand_type: str
+) -> tuple[np.ndarray, str]:
+    """Build the exact 43-D observation.state layout used by SONIC training."""
+    body = _required_state_vector(state_msg, "body_q", 29)
+    left, right, source = _policy_hand_state(state_msg, hand_type)
+    qpos = np.asarray(
+        robot_model.get_configuration_from_actuated_joints(
+            body_actuated_joint_values=body,
+            left_hand_actuated_joint_values=left,
+            right_hand_actuated_joint_values=right,
+        ),
+        dtype=np.float32,
+    ).reshape(-1)
+    if qpos.shape != (POLICY_STATE_DIM,):
+        raise ValueError(
+            f"SONIC policy state must have shape ({POLICY_STATE_DIM},), got {qpos.shape}"
+        )
+    if not np.isfinite(qpos).all():
+        raise ValueError("SONIC policy state contains non-finite values")
+    return qpos, source
+
+
+def pad_hand_to_wire(value: np.ndarray) -> np.ndarray:
+    """Keep policy hands six-dimensional; pad only for SONIC transport."""
+    value = np.asarray(value, dtype=np.float32)
+    if value.shape == (6,):
+        value = value.reshape(1, 6)
+    if value.shape != (1, 6) or not np.isfinite(value).all():
+        raise ValueError("Expected a finite six-dimensional Revo2 command")
+    return np.pad(value, ((0, 0), (0, 1)))
