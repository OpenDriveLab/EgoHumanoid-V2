+#!/usr/bin/env python3
+"""Receive only: the robot-side USB relay controls the camera.
+
+Receive a GoPro preview stream and publish the project's camera ZMQ schema.
+
+The relay records host decode time and a best-effort capture-time estimate made
+by subtracting the configured preview delay. GoPro Preview MPEG-TS does not
+expose an absolute exposure timestamp, so the estimate is diagnostic metadata,
+not a signal to rewind robot state. Consumers use decode time to reject stale
+transport frames.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+import os
+import signal
+import threading
+import time
+from typing import Optional
+
+import cv2
+import numpy as np
+
+
+DEFAULT_STREAM_URL = "udp://@0.0.0.0:8554"
+
+from gear_sonic.camera.sensor_server import (
+    CameraMountPosition,
+    ImageMessageSchema,
+    SensorServer,
+)
+
+
+@dataclass(frozen=True)
+class CapturedFrame:
+    frame: np.ndarray
+    captured_at: float
+    captured_monotonic: float
+    sequence: int
+
+
+class LatestFrameBuffer:
+    """Thread-safe single-frame buffer used to drop decoder backlog."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._latest: Optional[CapturedFrame] = None
+        self._sequence = 0
+
+    def store(
+        self,
+        frame: np.ndarray,
+        *,
+        captured_at: float,
+        captured_monotonic: float,
+    ) -> int:
+        with self._lock:
+            self._sequence += 1
+            self._latest = CapturedFrame(
+                frame=frame,
+                captured_at=captured_at,
+                captured_monotonic=captured_monotonic,
+                sequence=self._sequence,
+            )
+            return self._sequence
+
+    def snapshot(self, *, after_sequence: int = 0) -> Optional[CapturedFrame]:
+        with self._lock:
+            if self._latest is None or self._latest.sequence <= after_sequence:
+                return None
+            return self._latest
+
+
+def transform_frame(
+    frame: np.ndarray,
+    *,
+    rotation: int = 0,
+    output_width: int = 1280,
+    output_height: int = 720,
+    resize_mode: str = "crop",
+    flip_horizontal: bool = False,
+    flip_vertical: bool = False,
+) -> np.ndarray:
+    """Rotate/flip and resize a BGR frame without distorting its aspect ratio."""
+    if rotation == 90:
+        frame = cv2.rotate(frame, cv2.ROTATE_90_CLOCKWISE)
+    elif rotation == 180:
+        frame = cv2.rotate(frame, cv2.ROTATE_180)
+    elif rotation == 270:
+        frame = cv2.rotate(frame, cv2.ROTATE_90_COUNTERCLOCKWISE)
+    elif rotation != 0:
+        raise ValueError(f"rotation must be 0, 90, 180, or 270; got {rotation}")
+
+    if flip_horizontal and flip_vertical:
+        frame = cv2.flip(frame, -1)
+    elif flip_horizontal:
+        frame = cv2.flip(frame, 1)
+    elif flip_vertical:
+        frame = cv2.flip(frame, 0)
+
+    if output_width <= 0 or output_height <= 0 or resize_mode == "none":
+        return np.ascontiguousarray(frame)
+
+    src_h, src_w = frame.shape[:2]
+    if (src_w, src_h) == (output_width, output_height):
+        return np.ascontiguousarray(frame)
+
+    if resize_mode == "stretch":
+        return cv2.resize(frame, (output_width, output_height), interpolation=cv2.INTER_AREA)
+
+    target_aspect = output_width / output_height
+    source_aspect = src_w / src_h
+    if resize_mode == "crop":
+        if source_aspect > target_aspect:
+            crop_w = max(1, int(round(src_h * target_aspect)))
+            x0 = max(0, (src_w - crop_w) // 2)
+            frame = frame[:, x0 : x0 + crop_w]
+        elif source_aspect < target_aspect:
+            crop_h = max(1, int(round(src_w / target_aspect)))
+            y0 = max(0, (src_h - crop_h) // 2)
+            frame = frame[y0 : y0 + crop_h, :]
+        return cv2.resize(frame, (output_width, output_height), interpolation=cv2.INTER_AREA)
+
+    if resize_mode == "letterbox":
+        scale = min(output_width / src_w, output_height / src_h)
+        resized_w = max(1, int(round(src_w * scale)))
+        resized_h = max(1, int(round(src_h * scale)))
+        resized = cv2.resize(frame, (resized_w, resized_h), interpolation=cv2.INTER_AREA)
+        canvas = np.zeros((output_height, output_width, 3), dtype=np.uint8)
+        x0 = (output_width - resized_w) // 2
+        y0 = (output_height - resized_h) // 2
+        canvas[y0 : y0 + resized_h, x0 : x0 + resized_w] = resized
+        return canvas
+
+    raise ValueError(f"unsupported resize mode: {resize_mode}")
+
+
+def build_camera_payload(
+    frame: np.ndarray,
+    *,
+    captured_at: float,
+    received_at: Optional[float] = None,
+) -> dict:
+    """Build the existing base64-JPEG camera payload in RGB channel order."""
+    ego = CameraMountPosition.EGO_VIEW.value
+    timestamps = {ego: captured_at}
+    if received_at is not None:
+        timestamps[f"{ego}_received"] = received_at
+    return ImageMessageSchema(
+        timestamps=timestamps,
+        images={ego: frame},
+    ).serialize()
+
+
+def normalize_stream_url(url: str) -> str:
+    """Bound FFmpeg's UDP queue so recovery cannot replay old camera frames."""
+    if not url.startswith("udp://"):
+        return url
+    separator = "&" if "?" in url else "?"
+    options = []
+    if "overrun_nonfatal=" not in url:
+        options.append("overrun_nonfatal=1")
+    if "fifo_size=" not in url:
+        # fifo_size is counted in 188-byte TS packets, not bytes. Keep enough
+        # room for a short USB/NCM scheduling burst, but let FFmpeg drop if
+        # decoding falls behind instead of replaying stale frames.
+        options.append("fifo_size=8192")
+    if "buffer_size=" not in url:
+        options.append("buffer_size=1048576")
+    if "timeout=" not in url:
+        options.append("timeout=1000000")
+    return url + (separator + "&".join(options) if options else "")
+
+
+class GoProCaptureWorker:
+    """Continuously decode a stream into a latest-frame-only buffer."""
+
+    def __init__(self, args: argparse.Namespace, frames: LatestFrameBuffer) -> None:
+        self.args = args
+        self.frames = frames
+        self.stop_event = threading.Event()
+        self.thread = threading.Thread(target=self._run, daemon=True)
+        self.decoded_frames = 0
+        self.reconnects = 0
+        self.last_error = ""
+        self._capture: Optional[cv2.VideoCapture] = None
+
+    def start(self) -> None:
+        self.thread.start()
+
+    def stop(self) -> None:
+        self.stop_event.set()
+        # VideoCapture is not thread-safe: only the decoder thread may release it.
+        # Open/read operations have bounded timeouts, so allow either to finish.
+        self.thread.join(timeout=max(2.0, self.args.open_timeout_s,
+                                     self.args.read_timeout_s) + 1.0)
+        if self.thread.is_alive():
+            raise RuntimeError("GoPro decoder did not stop within its timeout")
+
+    def _open_capture(self) -> cv2.VideoCapture:
+        source = normalize_stream_url(self.args.stream_url)
+        os.environ.setdefault(
+            "OPENCV_FFMPEG_CAPTURE_OPTIONS",
+            "fflags;nobuffer|flags;low_delay|analyzeduration;0|probesize;32768|fpsprobesize;0",
+        )
+        params = []
+        open_timeout_prop = getattr(cv2, "CAP_PROP_OPEN_TIMEOUT_MSEC", None)
+        read_timeout_prop = getattr(cv2, "CAP_PROP_READ_TIMEOUT_MSEC", None)
+        if open_timeout_prop is not None:
+            params.extend((open_timeout_prop, int(max(0.0, self.args.open_timeout_s) * 1000)))
+        if read_timeout_prop is not None:
+            params.extend((read_timeout_prop, int(max(0.0, self.args.read_timeout_s) * 1000)))
+        thread_prop = getattr(cv2, "CAP_PROP_N_THREADS", None)
+        if thread_prop is not None:
+            # FFmpeg frame threading can retain decoded HEVC/H.264 frames.
+            params.extend((thread_prop, 1))
+        try:
+            if params:
+                capture = cv2.VideoCapture(source, cv2.CAP_FFMPEG, params)
+            else:
+                capture = cv2.VideoCapture(source, cv2.CAP_FFMPEG)
+        except (TypeError, cv2.error):
+            capture = cv2.VideoCapture(source, cv2.CAP_FFMPEG)
+        capture.set(cv2.CAP_PROP_BUFFERSIZE, 1)
+        return capture
+
+    def _run(self) -> None:
+        while not self.stop_event.is_set():
+            try:
+                capture = self._open_capture()
+            except Exception as exc:
+                self.last_error = f"decoder open failed: {exc}"
+                print(f"[GoPro] {self.last_error}; retrying", flush=True)
+                self.reconnects += 1
+                self.stop_event.wait(self.args.reconnect_delay_s)
+                continue
+            self._capture = capture
+            if not capture.isOpened():
+                self.last_error = f"could not open {self.args.stream_url}"
+                print(f"[GoPro] {self.last_error}; retrying", flush=True)
+                capture.release()
+                self._capture = None
+                self.reconnects += 1
+                self.stop_event.wait(self.args.reconnect_delay_s)
+                continue
+
+            print(f"[GoPro] decoder connected: {self.args.stream_url}", flush=True)
+            consecutive_failures = 0
+            while not self.stop_event.is_set():
+                try:
+                    ok, frame = capture.read()
+                except Exception as exc:
+                    ok, frame = False, None
+                    self.last_error = f"stream read failed: {exc}"
+                captured_monotonic = time.monotonic()
+                captured_at = time.time()
+                if not ok or frame is None:
+                    consecutive_failures += 1
+                    if consecutive_failures >= self.args.read_failures_before_reconnect:
+                        self.last_error = "stream read timed out or ended"
+                        break
+                    continue
+
+                consecutive_failures = 0
+                frame = transform_frame(
+                    frame,
+                    rotation=self.args.rotation,
+                    output_width=self.args.output_width,
+                    output_height=self.args.output_height,
+                    resize_mode=self.args.resize_mode,
+                    flip_horizontal=self.args.flip_horizontal,
+                    flip_vertical=self.args.flip_vertical,
+                )
+                self.frames.store(
+                    frame,
+                    captured_at=captured_at,
+                    captured_monotonic=captured_monotonic,
+                )
+                self.decoded_frames += 1
+
+            capture.release()
+            self._capture = None
+            if not self.stop_event.is_set():
+                self.reconnects += 1
+                print(f"[GoPro] {self.last_error}; reconnecting", flush=True)
+                self.stop_event.wait(self.args.reconnect_delay_s)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="GoPro Preview/stream to camera ZMQ relay")
+    parser.add_argument("--stream-url", default=DEFAULT_STREAM_URL)
+    parser.add_argument("--pub-port", type=int, default=5559)
+    parser.add_argument("--fps", type=float, default=30.0, help="Maximum ZMQ publish rate")
+    parser.add_argument(
+        "--capture-delay-s",
+        type=float,
+        default=0.21,
+        help="Calibrated preview latency subtracted from host decode time",
+    )
+    parser.add_argument("--output-width", type=int, default=1280)
+    parser.add_argument("--output-height", type=int, default=720)
+    parser.add_argument("--resize-mode", choices=("crop", "letterbox", "stretch", "none"), default="crop")
+    parser.add_argument("--rotation", type=int, choices=(0, 90, 180, 270), default=0)
+    parser.add_argument("--flip-horizontal", action="store_true")
+    parser.add_argument("--flip-vertical", action="store_true")
+
+    parser.add_argument("--open-timeout-s", type=float, default=5.0)
+    parser.add_argument("--read-timeout-s", type=float, default=2.0)
+    parser.add_argument("--read-failures-before-reconnect", type=int, default=3)
+    parser.add_argument("--reconnect-delay-s", type=float, default=1.0)
+    parser.add_argument("--verbose", action="store_true")
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    frames = LatestFrameBuffer()
+    publisher = SensorServer()
+    publisher.start_server(args.pub_port)
+    capture = GoProCaptureWorker(args, frames)
+    capture.start()
+
+    shutdown = threading.Event()
+
+    def handle_signal(_signum, _frame) -> None:
+        shutdown.set()
+
+    signal.signal(signal.SIGINT, handle_signal)
+    signal.signal(signal.SIGTERM, handle_signal)
+
+    print(
+        f"[GoPro] relay udp/input={args.stream_url} -> tcp://*:{args.pub_port} "
+        f"at <= {args.fps:g} FPS, output={args.output_width}x{args.output_height}",
+        flush=True,
+    )
+    publish_interval = 1.0 / max(1.0, args.fps)
+    last_sequence = 0
+    published_frames = 0
+    last_stats_time = time.monotonic()
+    last_stats_frames = 0
+    try:
+        while not shutdown.is_set():
+            loop_start = time.monotonic()
+            captured = frames.snapshot(after_sequence=last_sequence)
+            if captured is not None:
+                estimated_capture_at = captured.captured_at - max(0.0, args.capture_delay_s)
+                # The decoder yields OpenCV BGR. Camera consumers and the GR00T
+                # training-video loader use RGB arrays.
+                frame_rgb = cv2.cvtColor(captured.frame, cv2.COLOR_BGR2RGB)
+                publisher.send_message(
+                    build_camera_payload(
+                        frame_rgb,
+                        captured_at=estimated_capture_at,
+                        received_at=captured.captured_at,
+                    )
+                )
+                last_sequence = captured.sequence
+                published_frames += 1
+
+            now = time.monotonic()
+            if args.verbose and now - last_stats_time >= 5.0:
+                window = now - last_stats_time
+                fps = (published_frames - last_stats_frames) / window
+                latest = frames.snapshot()
+                age = now - latest.captured_monotonic if latest is not None else float("inf")
+                print(
+                    f"[GoPro] published={published_frames} fps={fps:.1f} "
+                    f"last_frame_age={age:.3f}s reconnects={capture.reconnects}",
+                    flush=True,
+                )
+                last_stats_time = now
+                last_stats_frames = published_frames
+
+            remaining = publish_interval - (time.monotonic() - loop_start)
+            shutdown.wait(max(0.001, remaining))
+    finally:
+        capture.stop()
+        publisher.stop_server()
+        print(f"[GoPro] stopped after publishing {published_frames} frames", flush=True)
+
+
+if __name__ == "__main__":
+    main()
