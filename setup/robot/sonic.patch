@@ -0,0 +1,79 @@
+#ifndef PLANNER_SPECIFIC_TARGET_HPP
+#define PLANNER_SPECIFIC_TARGET_HPP
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <optional>
+
+namespace planner_specific_target {
+
+inline constexpr std::size_t kWaypointCount = 4;
+inline constexpr std::size_t kPositionDimension = 3;
+inline constexpr std::size_t kPositionValueCount =
+    kWaypointCount * kPositionDimension;
+
+// Coordinates use the same planner-local qpos frame as context_mujoco_qpos.
+struct Target {
+  std::array<float, kPositionValueCount> positions{};
+  std::array<float, kWaypointCount> headings{};
+
+  bool operator==(const Target&) const = default;
+};
+
+struct TensorValues {
+  int64_t has_specific_target = 0;
+  std::array<float, kPositionValueCount> positions{};
+  std::array<float, kWaypointCount> headings{};
+};
+
+enum class ApplyStatus {
+  Applied,
+  Cleared,
+  UnsupportedVersion,
+  NonFinite,
+};
+
+inline void ClearTensorValues(TensorValues& values) {
+  values.has_specific_target = 0;
+  values.positions.fill(0.0F);
+  values.headings.fill(0.0F);
+}
+
+inline bool IsFinite(const Target& target) {
+  // std::isfinite is not reliable under this project's global -ffast-math.
+  const auto finite_float = [](float value) {
+    constexpr uint32_t kExponentMask = 0x7f800000U;
+    return (std::bit_cast<uint32_t>(value) & kExponentMask) != kExponentMask;
+  };
+  return std::all_of(target.positions.begin(), target.positions.end(),
+                     finite_float) &&
+         std::all_of(target.headings.begin(), target.headings.end(),
+                     finite_float);
+}
+
+inline ApplyStatus PopulateTensorValues(
+    int planner_version,
+    const std::optional<Target>& target,
+    TensorValues& values) {
+  ClearTensorValues(values);
+  if (!target.has_value()) {
+    return ApplyStatus::Cleared;
+  }
+  if (planner_version != 1 && planner_version != 2) {
+    return ApplyStatus::UnsupportedVersion;
+  }
+  if (!IsFinite(*target)) {
+    return ApplyStatus::NonFinite;
+  }
+
+  values.has_specific_target = 1;
+  values.positions = target->positions;
+  values.headings = target->headings;
+  return ApplyStatus::Applied;
+}
+
+}  // namespace planner_specific_target
+
+#endif  // PLANNER_SPECIFIC_TARGET_HPP
